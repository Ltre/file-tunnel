{
  "name": "instant-tunnel",
  "version": "1.0.0",
  "description": "即时传输隧道 - 安全的设备间P2P文件传输和协同编辑",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node -e \"process.env.YT_DLP_PROXY=process.env.YT_DLP_PROXY||'http://127.0.0.1:58591';process.env.YT_DLP_ALL_PROXY=process.env.YT_DLP_ALL_PROXY||'socks5://127.0.0.1:51837';process.env.YT_DLP_BIN=process.env.YT_DLP_BIN||(process.platform==='win32'?'py':'python3');process.env.YT_DLP_BIN_ARGS=process.env.YT_DLP_BIN_ARGS||'-m yt_dlp';require('./server.js')\"",
    "dev:no-proxy": "node -e \"process.env.YT_DLP_BIN=process.env.YT_DLP_BIN||(process.platform==='win32'?'py':'python3');process.env.YT_DLP_BIN_ARGS=process.env.YT_DLP_BIN_ARGS||'-m yt_dlp';require('./server.js')\"",
    "ytdlp:doctor": "node -e \"const {spawnSync}=require('child_process');for(const cmd of [['yt-dlp','--version'],['py','-m','yt_dlp','--version'],['python','-m','yt_dlp','--version'],['python3','-m','yt_dlp','--version']]){const r=spawnSync(cmd[0],cmd.slice(1),{encoding:'utf8'});console.log(cmd.join(' '),'=>',(r.stdout||r.stderr||r.error?.message||'').trim())}\"",
    "test:p2p:unit": "node tests/p2p-connection-regression.test.cjs",
    "test:youtube-premium": "node tests/youtube-premium.test.cjs",
    "build:sns-cookie-extension": "node tools/auto-sync-sns-cookies/build.mjs",
    "deploy:build": "node tools/deploy/build.mjs",
    "deploy:verify": "node tools/deploy/verify.mjs"
  },
  "keywords": [
    "p2p",
    "file-transfer",
    "webrtc",
    "collaboration",
    "real-time"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "socket.io": "^4.7.2",
    "sql.js": "^1.14.1"
  },
  "devDependencies": {
    "esbuild": "^0.28.1",
    "html-minifier-terser": "^7.2.0",
    "terser": "^5.49.0"
  }
}
