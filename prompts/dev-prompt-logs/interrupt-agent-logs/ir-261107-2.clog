	import json,re,urllib.parse,urllib.request,http.cookiejar
	jar=http.cookiejar.CookieJar()
	client=urllib.request.build_opener(urllib.request.HTTPCookieProcessor(jar))
	client.addheaders=[('User-Agent','Mozilla/5.0')]
	with client.open('https://www.bing.com/translator',timeout=20) as response: html=response.read().decode('utf-8')
	parameters=re.search(r'params_AbusePreventionHelper\s*=\s*(\[[^;]+\])',html)
	identity=re.search(r'IG:"([^"]+)"',html)
	if not parameters or not identity: raise RuntimeError('Public translator is not available; no access challenge will be bypassed')
	key,token,*rest=json.loads(parameters.group(1))
	body=urllib.parse.urlencode({'fromLang':'zh-Hans','to':'ja','text':'使用系统语言','token':token,'key':key}).encode()
	request=urllib.request.Request('https://www.bing.com/ttranslatev3?isVertical=1&IG='+identity.group(1)+'&IID=translator.5028',data=body)
	with client.open(request,timeout=20) as response: data=json.load(response)
	print(json.dumps({'translation':data[0]['translations'][0]['text']},ensure_ascii=False))
