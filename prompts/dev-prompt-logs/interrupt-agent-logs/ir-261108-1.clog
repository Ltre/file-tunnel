	const fs=require('fs'),vm=require('vm'),c={window:{}};vm.runInNewContext(fs.readFileSync('client/i18n-catalog.js','utf8'),c);const cat=c.window.Drop2TunnelI18nCatalog,langs=c.window.Drop2TunnelI18nConfig.dynamicLanguages,norm=s=>s.replace(/[\s。；;，,:：.!！?？]+$/g,'');let full=new Map();for(const [k,v]of Object.entries(cat))if(langs.every(l=>v[l]))full.set(norm(k),{k,v});let rows=JSON.parse(fs.readFileSync('.npm-cache/i18n-disk-errors-261109.json','utf8'));console.log(rows.map((r,i)=>({i,parts:r.phrase.split(/[。；]/).filter(Boolean)})).filter(r=>r.parts.every(p=>full.has(norm(p)))).map(r=>r.i+' '+r.parts.join(' | ')).join('\n'));console.log('existing clause examples');for(const k of ['文件不存在或已被删除','请刷新列表','请联系所有者','请重新选择目标','请重新执行操作'])console.log(k,full.get(k)?.k);
